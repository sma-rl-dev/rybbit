#!/usr/bin/env bash
# tester-env CLI for the rybbit fork deployment overlay (fork root).
#
# Image policy: IMAGE_TAG is exported by scripts/rl-env as a
# content-addressed tag so identical (baseline, patch-set) combos share an
# image. Manual invocations default to tester-env-rybbit:dev. RUN_ID scopes
# ONLY containers/volumes (compose project name), never the image name.
#
# Usage: ./tester-env {deploy|seed|verify|reset|stop|status|logs|help}
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_BASE="${SCRIPT_DIR}/docker-compose.yml"
COMPOSE_OVERLAY="${SCRIPT_DIR}/docker-compose.tester-env.yml"

# IMAGE_TAG is one tag shared by every service built from this source tree
# (single backend/client source build). rl-env sets it; manual runs get :dev.
IMAGE_TAG="${IMAGE_TAG:-tester-env-rybbit:dev}"
export IMAGE_TAG

# Public entry port. scripts/rl-env allocates it; the same-origin Caddy proxy
# publishes it, and page + API share that origin. Backend (3001), client
# (3002) and the databases stay on the compose network only.
PORT="${PORT:-8080}"
export PORT

# Origin the runner browser (or a human) uses for this run. Explicit operator
# BASE_URL / TESTER_ENV_BROWSER_ORIGIN wins; manual runs fall back to
# localhost. It is the trusted origin and is baked into the client bundle.
ORIGIN="${BASE_URL:-${TESTER_ENV_BROWSER_ORIGIN:-http://localhost:${PORT}}}"
ORIGIN="${ORIGIN%/}"
export BASE_URL="${ORIGIN}"

SUFFIX="${RUN_ID:+-${RUN_ID}}"
PROJECT="tester-env-rybbit${SUFFIX}"
# Compose interpolation for per-run container names (the base file pins global
# container_name values that would otherwise collide across runs).
RUN_ID_SUFFIX="${SUFFIX}"
export RUN_ID_SUFFIX

# Backend trusted CORS origins for this run's page origins: the proxy serves
# page and API on one port (see server/src/lib/cors.ts). TESTER_ENV_PUBLIC_ORIGIN
# is appended for public-tunnel runs only, never baked into images.
TRUSTED_ORIGINS="${ORIGIN},http://localhost:${PORT},http://127.0.0.1:${PORT}"
if [[ -n "${TESTER_ENV_PUBLIC_ORIGIN:-}" ]]; then
  TRUSTED_ORIGINS="${TRUSTED_ORIGINS},${TESTER_ENV_PUBLIC_ORIGIN}"
fi
export TRUSTED_ORIGINS

# Scoped ClickHouse access for seed/verify (no ClickHouse host port published).
# Password matches the pinned compose default (CLICKHOUSE_PASSWORD:-frog).
export RYBBIT_CH_QUERY="docker compose -f ${COMPOSE_BASE} -f ${COMPOSE_OVERLAY} -p ${PROJECT} exec -T clickhouse clickhouse-client --user default --password frog --query"

SEED_EMAIL="${SEED_EMAIL:-tester@example.com}"
SEED_PASSWORD="${SEED_PASSWORD:-TestPass123!}"
SEED_ORG_NAME="${SEED_ORG_NAME:-Test Org}"
SEED_ORG_SLUG="${SEED_ORG_SLUG:-test-org}"
SEED_SITE_1_DOMAIN="${SEED_SITE_1_DOMAIN:-example.com}"
SEED_SITE_2_DOMAIN="${SEED_SITE_2_DOMAIN:-second.com}"
export SEED_EMAIL SEED_PASSWORD SEED_ORG_NAME SEED_ORG_SLUG
export SEED_SITE_1_DOMAIN SEED_SITE_2_DOMAIN

log() { echo "==> $*"; }

dc() {
  docker compose -f "${COMPOSE_BASE}" -f "${COMPOSE_OVERLAY}" -p "${PROJECT}" "$@"
}

app_url() { echo "${ORIGIN}"; }

wait_backend() {
  log "Waiting for the app origin at $(app_url)/api/health ..."
  local i
  for i in $(seq 1 60); do
    if curl -sf -m 5 "$(app_url)/api/health" >/dev/null 2>&1 \
      || curl -sf -m 5 "$(app_url)/api/auth/get-session" >/dev/null 2>&1; then
      log "App origin is ready."
      return 0
    fi
    sleep 5
  done
  echo "ERROR: app origin did not become ready within ~300s" >&2
  return 1
}

wait_services() {
  log "Waiting for postgres/clickhouse/redis to report healthy ..."
  local i
  for i in $(seq 1 30); do
    if dc ps --format '{{.Service}} {{.Health}}' 2>/dev/null | grep -qvE 'healthy|running' >/dev/null 2>&1; then
      sleep 5
    else
      return 0
    fi
  done
  return 0
}

cmd_deploy() {
  log "Building images (${IMAGE_TAG}) and starting stack for project '${PROJECT}'"
  log "Publishing the same-origin proxy on port ${PORT} (origin $(app_url))"
  dc build
  dc up -d
  wait_services || true
  wait_backend
  log "Deployment complete."
  log "App (page + API, same origin): $(app_url)"
  log "First run: ./tester-env seed bootstraps ${SEED_EMAIL} / [SEED_PASSWORD], org '${SEED_ORG_NAME}', site '${SEED_SITE_1_DOMAIN}' via --bootstrap when missing."
  log "Then run: ./tester-env verify"
}

cmd_seed() {
  log "Seeding deterministic Rybbit analytics via the same-origin proxy ($(app_url))"
  log "Bootstrap: creates first user/org/sites via signup API when missing (idempotent)"
  python3 "${SCRIPT_DIR}/tester-env-seed/seed.py" \
    --base-url "$(app_url)" --site-id 1 --bootstrap
  log "Seed complete."
}

cmd_verify() {
  log "Verifying deterministic Rybbit seed data ($(app_url), site 1)"
  python3 "${SCRIPT_DIR}/tester-env-seed/verify.py" \
    --base-url "$(app_url)" --site-id 1 \
    --email "${SEED_EMAIL}" --password "${SEED_PASSWORD}"
  log "Verify complete."
}

cmd_reset() {
  log "Removing containers and volumes for project '${PROJECT}' only (images kept)"
  dc down -v --remove-orphans 2>/dev/null || true
  log "Clean slate. Run './tester-env deploy' to start fresh (then seed --bootstrap + verify)."
}

cmd_stop() {
  log "Stopping containers for project '${PROJECT}' (volumes preserved)"
  dc stop 2>/dev/null || true
  log "Stopped."
}

cmd_status() {
  log "Rybbit Tester Environment Status (project '${PROJECT}')"
  local running
  running=$(dc ps 2>/dev/null || true)
  if [[ -z "$running" ]]; then
    echo "Status: NOT RUNNING"
  else
    echo "$running"
    echo ""
    echo "URL: $(app_url)"
    echo "Seed login: ${SEED_EMAIL} / [SEED_PASSWORD]"
  fi
}

cmd_logs() {
  dc logs --tail=200 "$@"
}

cmd_help() {
  cat <<EOF
Rybbit - Tester Environment CLI

Usage: $0 COMMAND

Commands:
  deploy   Build backend+client images from source, start the stack, wait healthy.
  seed     Load deterministic seed dataset via /api/track (clears first; idempotent).
  verify   Assert expected seed counts/states via API (exit non-zero on mismatch).
  reset    Stop and remove this project's containers AND volumes (clean slate).
  stop     Stop containers without deleting volumes/data.
  status   Show container state and URLs.
  logs     Print recent logs (optionally: $0 logs <service>).
  help     Show this message.

Env vars:
  IMAGE_TAG    Shared image name/tag for source builds (default tester-env-rybbit:dev; set by scripts/rl-env)
  RUN_ID       Optional run id; scopes container/volume names only (never images).
  PORT         Public entry port for the same-origin proxy (set by scripts/rl-env; default 8080).
  BASE_URL     Absolute app origin baked into the client and trusted by the backend
               (default TESTER_ENV_BROWSER_ORIGIN, else http://localhost:\$PORT).
  TESTER_ENV_PUBLIC_ORIGIN  Runtime tunnel origin (launcher only); appended to
               backend TRUSTED_ORIGINS, never baked into images.

Credentials (deterministic): ${SEED_EMAIL} / [SEED_PASSWORD]
Org: ${SEED_ORG_NAME} (${SEED_ORG_SLUG}); Sites: ${SEED_SITE_1_DOMAIN} (seeded), ${SEED_SITE_2_DOMAIN} (empty edge case)
EOF
}

case "${1:-help}" in
  deploy) cmd_deploy ;;
  seed) cmd_seed ;;
  verify) cmd_verify ;;
  reset) cmd_reset ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) shift 2>/dev/null || true; cmd_logs "$@" ;;
  help|--help|-h|*) cmd_help ;;
esac
